rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Catálogo: lectura pública; escritura SOLO desde el sincronizador
    // (cuenta de servicio / Admin SDK, que no pasa por estas reglas).
    match /catalogo_shards/{id}    { allow read: if true; allow write: if false; }
    match /catalogo_meta/{id}      { allow read: if true; allow write: if false; }
    match /catalogo_novedades/{id} { allow read: if true; allow write: if false; }

    // Consultas anónimas para reentrenar: se pueden crear y valorar (👍/👎),
    // pero nadie puede leerlas desde la web.
    match /consultas/{id} {
      allow read, delete: if false;
      allow create: if request.resource.data.keys().hasOnly(['pregunta', 'respuesta', 'ids', 'modelo', 'ts'])
        && request.resource.data.pregunta is string && request.resource.data.pregunta.size() <= 500
        && request.resource.data.respuesta is string && request.resource.data.respuesta.size() <= 4000
        && request.resource.data.ids is list && request.resource.data.ids.size() <= 10
        && request.resource.data.modelo is string && request.resource.data.modelo.size() <= 120
        && request.resource.data.ts == request.time;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['util'])
        && request.resource.data.util is bool;
    }
  }
}
